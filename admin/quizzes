
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>TECHBRIDGE RWANDA — Admin Quizzes</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
 --bg:#070b14;
 --panel:#0d1527;
 --panel2:#111c31;
 --border:rgba(255,255,255,.08);
 --text:#f8fafc;
 --muted:#94a3b8;
 --cyan:#00e5ff;
 --blue:#3b82f6;
 --purple:#a855f7;
 --green:#22c55e;
 --red:#ef4444;
 --yellow:#f59e0b;
}

body{
 font-family:Inter,Arial,sans-serif;
 color:var(--text);
 background:
 radial-gradient(circle at 10% 0%,rgba(0,229,255,.08),transparent 28%),
 radial-gradient(circle at 90% 100%,rgba(168,85,247,.08),transparent 30%),
 var(--bg);
 min-height:100vh;
}

button,input,select,textarea{font:inherit}

button{cursor:pointer}

a{
 color:inherit;
 text-decoration:none;
}

.app{
 min-height:100vh;
 display:flex;
}

.sidebar{
 width:250px;
 position:fixed;
 inset:0 auto 0 0;
 padding:20px 14px;
 border-right:1px solid var(--border);
 background:rgba(7,11,20,.94);
 backdrop-filter:blur(18px);
 z-index:30;
}

.brand{
 display:flex;
 align-items:center;
 gap:10px;
 padding:0 8px 25px;
}

.logo{
 width:42px;
 height:42px;
 display:grid;
 place-items:center;
 border-radius:12px;
 color:#041018;
 font-weight:900;
 background:linear-gradient(135deg,var(--cyan),var(--blue));
}

.brand strong{
 display:block;
 font-size:13px;
}

.brand span{
 color:var(--muted);
 font-size:9px;
}

.nav-title{
 color:#64748b;
 font-size:9px;
 font-weight:900;
 letter-spacing:1px;
 padding:12px 10px 7px;
 text-transform:uppercase;
}

.nav a{
 display:flex;
 align-items:center;
 gap:10px;
 padding:11px 12px;
 margin:3px 0;
 border-radius:10px;
 color:#94a3b8;
 font-size:11px;
 transition:.15s;
}

.nav a:hover,
.nav a.active{
 color:white;
 background:rgba(0,229,255,.08);
}

.nav a.active{
 border:1px solid rgba(0,229,255,.15);
}

.logout{
 position:absolute;
 bottom:18px;
 left:14px;
 right:14px;
 width:calc(100% - 28px);
 padding:11px;
 border:1px solid rgba(239,68,68,.15);
 border-radius:10px;
 color:#fca5a5;
 background:rgba(239,68,68,.05);
}

.main{
 margin-left:250px;
 width:calc(100% - 250px);
 padding:25px;
}

.top{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:15px;
 margin-bottom:22px;
}

.top h1{
 font-size:25px;
}

.top p{
 margin-top:5px;
 color:var(--muted);
 font-size:11px;
}

.mobile-menu{
 display:none;
}

.create-btn{
 border:0;
 padding:11px 15px;
 border-radius:10px;
 color:#041018;
 background:linear-gradient(135deg,var(--cyan),var(--blue));
 font-weight:900;
 font-size:11px;
}

.stats{
 display:grid;
 grid-template-columns:repeat(5,1fr);
 gap:12px;
 margin-bottom:18px;
}

.stat{
 padding:16px;
 border:1px solid var(--border);
 border-radius:15px;
 background:rgba(255,255,255,.035);
}

.stat small{
 color:var(--muted);
 font-size:9px;
 display:block;
 margin-bottom:8px;
}

.stat strong{
 font-size:23px;
}

.toolbar{
 display:flex;
 gap:9px;
 flex-wrap:wrap;
 margin-bottom:15px;
}

.search{
 flex:1;
 min-width:220px;
}

input,select,textarea{
 width:100%;
 border:1px solid var(--border);
 outline:none;
 color:white;
 background:#0a1221;
 border-radius:10px;
 padding:11px 12px;
 font-size:11px;
}

textarea{
 min-height:90px;
 resize:vertical;
}

input:focus,
select:focus,
textarea:focus{
 border-color:rgba(0,229,255,.4);
}

.filter{
 width:150px;
}

.table-wrap{
 overflow:auto;
 border:1px solid var(--border);
 border-radius:16px;
 background:rgba(255,255,255,.025);
}

table{
 width:100%;
 min-width:850px;
 border-collapse:collapse;
}

th,td{
 padding:13px 14px;
 text-align:left;
 border-bottom:1px solid var(--border);
 font-size:10px;
}

th{
 color:#64748b;
 font-size:9px;
 text-transform:uppercase;
 letter-spacing:.6px;
}

td{
 color:#cbd5e1;
}

tbody tr:hover{
 background:rgba(255,255,255,.025);
}

.badge{
 display:inline-block;
 padding:5px 8px;
 border-radius:999px;
 font-size:8px;
 font-weight:900;
}

.published{
 color:#86efac;
 background:rgba(34,197,94,.09);
}

.draft{
 color:#fcd34d;
 background:rgba(245,158,11,.09);
}

.beginner{
 color:#67e8f9;
 background:rgba(0,229,255,.08);
}

.intermediate{
 color:#93c5fd;
 background:rgba(59,130,246,.08);
}

.advanced{
 color:#d8b4fe;
 background:rgba(168,85,247,.08);
}

.actions{
 display:flex;
 gap:6px;
}

.action{
 border:1px solid var(--border);
 border-radius:8px;
 padding:7px 9px;
 color:#cbd5e1;
 background:rgba(255,255,255,.035);
 font-size:9px;
}

.action.delete{
 color:#fca5a5;
}

.empty{
 padding:45px 20px;
 text-align:center;
 color:var(--muted);
 font-size:12px;
}

.overlay{
 position:fixed;
 inset:0;
 z-index:100;
 display:none;
 align-items:center;
 justify-content:center;
 padding:18px;
 background:rgba(0,0,0,.7);
 backdrop-filter:blur(8px);
}

.overlay.show{
 display:flex;
}

.modal{
 width:min(850px,100%);
 max-height:92vh;
 overflow:auto;
 padding:22px;
 border:1px solid var(--border);
 border-radius:20px;
 background:#0c1424;
 box-shadow:0 20px 80px rgba(0,0,0,.5);
}

.modal-head{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:12px;
 margin-bottom:18px;
}

.modal-head h2{
 font-size:18px;
}

.close{
 width:32px;
 height:32px;
 border:1px solid var(--border);
 border-radius:9px;
 color:#cbd5e1;
 background:rgba(255,255,255,.04);
}

.form-grid{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:11px;
}

.field.full{
 grid-column:1/-1;
}

.field label{
 display:block;
 color:#94a3b8;
 font-size:9px;
 margin-bottom:6px;
}

.questions-title{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:10px;
 margin:20px 0 10px;
}

.questions-title strong{
 font-size:12px;
}

.add-question{
 border:1px solid rgba(0,229,255,.2);
 padding:8px 10px;
 border-radius:9px;
 color:var(--cyan);
 background:rgba(0,229,255,.05);
 font-size:9px;
 font-weight:900;
}

.question-box{
 margin-bottom:11px;
 padding:14px;
 border:1px solid var(--border);
 border-radius:13px;
 background:rgba(255,255,255,.025);
}

.question-head{
 display:flex;
 justify-content:space-between;
 align-items:center;
 margin-bottom:10px;
}

.question-head strong{
 font-size:10px;
 color:var(--cyan);
}

.remove-question{
 border:0;
 color:#fca5a5;
 background:transparent;
 font-size:9px;
}

.options-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px;
}

.option-row{
 display:grid;
 grid-template-columns:1fr 80px;
 gap:7px;
}

.modal-actions{
 display:flex;
 justify-content:flex-end;
 gap:8px;
 margin-top:20px;
}

.cancel-btn,
.save-btn{
 padding:11px 15px;
 border-radius:10px;
 font-size:10px;
 font-weight:900;
}

.cancel-btn{
 border:1px solid var(--border);
 color:#cbd5e1;
 background:rgba(255,255,255,.04);
}

.save-btn{
 border:0;
 color:#041018;
 background:linear-gradient(135deg,var(--cyan),var(--blue));
}

.save-btn:disabled{
 opacity:.5;
 cursor:not-allowed;
}

.toast{
 position:fixed;
 right:20px;
 bottom:20px;
 z-index:200;
 display:none;
 max-width:360px;
 padding:12px 15px;
 border:1px solid var(--border);
 border-radius:11px;
 color:white;
 background:#111c31;
 box-shadow:0 10px 40px rgba(0,0,0,.35);
 font-size:10px;
}

.toast.show{
 display:block;
}

@media(max-width:900px){

 .sidebar{
  transform:translateX(-100%);
  transition:.2s;
 }

 .sidebar.open{
  transform:translateX(0);
 }

 .main{
  margin-left:0;
  width:100%;
  padding:18px;
 }

 .mobile-menu{
  display:grid;
  place-items:center;
  width:38px;
  height:38px;
  border:1px solid var(--border);
  border-radius:10px;
  color:white;
  background:rgba(255,255,255,.04);
 }

 .top{
  align-items:flex-start;
 }

 .top-left{
  display:flex;
  gap:9px;
 }

 .stats{
  grid-template-columns:repeat(2,1fr);
 }

}

@media(max-width:600px){

 .top{
  flex-direction:column;
 }

 .top-left{
  width:100%;
 }

 .create-btn{
  width:100%;
 }

 .stats{
  grid-template-columns:1fr 1fr;
 }

 .form-grid,
 .options-grid{
  grid-template-columns:1fr;
 }

 .field.full{
  grid-column:auto;
 }

 .modal-actions{
  flex-direction:column;
 }

 .modal-actions button{
  width:100%;
 }
}
</style>
</head>

<body>


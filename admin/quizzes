<aside class="sidebar" id="sidebar">

 <div class="brand">
  <div class="logo">TB</div>
  <div>
   <strong>TECHBRIDGE RWANDA</strong>
   <span>ADMIN PANEL</span>
  </div>
 </div>

 <nav class="nav">

  <div class="nav-title">Management</div>

  <a href="./index.html">▦ Dashboard</a>

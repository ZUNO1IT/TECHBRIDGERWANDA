<div class="toast" id="toast"></div>


<script type="module">

import {
 initializeApp
} from "https://www.gstatic.com/firebasejs/12.3.0/firebase-app.js";

import {
 getAuth,
 onAuthStateChanged,
 getIdTokenResult,
 signOut
} from "https://www.gstatic.com/firebasejs/12.3.0/firebase-auth.js";

import {
 getFirestore,
 collection,
 getDocs,
 doc,
 setDoc,
 updateDoc,
 deleteDoc,
 serverTimestamp
} from "https://www.gstatic.com/firebasejs/12.3.0/firebase-firestore.js";


const firebaseConfig = {

 apiKey:
  "AIzaSyAIeekQOHDHt--r4KbPU8YOgueG3P1249g",

 authDomain:
  "techbrige-rwanda.firebaseapp.com",

 projectId:
  "techbrige-rwanda",

 storageBucket:
  "techbrige-rwanda.firebasestorage.app",

 messagingSenderId:
  "391783540774",

 appId:
  "1:391783540774:web:de825e268d4ed6b2711ee7"

};


const app =
 initializeApp(firebaseConfig);

const auth =
 getAuth(app);

const db =
 getFirestore(app);


/* =========================
   STATE
========================= */

let quizzes = [];

let editingId = null;

let questionCounter = 0;


/* =========================
   ELEMENTS
========================= */

const table =
 document.getElementById("quizTable");

const emptyState =
 document.getElementById("emptyState");

const modal =
 document.getElementById("modalOverlay");

const form =
 document.getElementById("quizForm");

const questionsContainer =
 document.getElementById("questionsContainer");

const modalTitle =
 document.getElementById("modalTitle");


/* =========================
   AUTH CHECK
========================= */

onAuthStateChanged(
 auth,
 async user => {

  if(!user){

   window.location.href =
    "../login.html";

   return;

  }


  try{

   const tokenResult =
    await getIdTokenResult(
     user,
     true
    );


   if(
    tokenResult.claims.admin !== true
   ){

    alert(
     "Admin access is required."
    );

    window.location.href =
     "../students/index.html";

    return;

   }


   await loadQuizzes();

  }catch(error){

   console.error(error);

   alert(
    "Unable to verify admin access."
   );

   window.location.href =
    "../login.html";

  }

 });


/* =========================
   LOAD QUIZZES
========================= */

async function loadQuizzes(){

 try{

  const snapshot =
   await getDocs(
    collection(
     db,
     "quizzes"
    )
   );


  quizzes =
   snapshot.docs.map(
    item => ({
     id:item.id,
     ...item.data()
    })
   );


  quizzes.sort(
   (a,b)=>
    String(
     a.title || a.name || ""
    ).localeCompare(
     String(
      b.title || b.name || ""
     )
    )
  );


  updateStats();

  renderTable();

 }catch(error){

  console.error(error);

  showToast(
   "Could not load quizzes: " +
   error.message
  );

 }

}


/* =========================
   STATS
========================= */

function updateStats(){

 const published =
  quizzes.filter(
   q => q.status === "published"
  ).length;


 const draft =
  quizzes.filter(
   q => q.status === "draft"
  ).length;


 const beginner =
  quizzes.filter(
   q => q.level === "Beginner"
  ).length;


 const advanced =
  quizzes.filter(
   q => q.level === "Advanced"
  ).length;


 document.getElementById(
  "totalStat"
 ).textContent =
  quizzes.length;


 document.getElementById(
  "publishedStat"
 ).textContent =
  published;


 document.getElementById(
  "draftStat"
 ).textContent =
  draft;


 document.getElementById(
  "beginnerStat"
 ).textContent =
  beginner;


 document.getElementById(
  "advancedStat"
 ).textContent =
  advanced;

}


/* =========================
   FILTER
========================= */

document.getElementById(
 "searchInput"
).addEventListener(
 "input",
 renderTable
);

document.getElementById(
 "levelFilter"
).addEventListener(
 "change",
 renderTable
);

document.getElementById(
 "statusFilter"
).addEventListener(
 "change",
 renderTable
);


function renderTable(){

 const search =
  document.getElementById(
   "searchInput"
  ).value
   .trim()
   .toLowerCase();


 const level =
  document.getElementById(
   "levelFilter"
  ).value;


 const status =
  document.getElementById(
   "statusFilter"
  ).value;


 const filtered =
  quizzes.filter(
   quiz => {

    const haystack =
     [
      quiz.id,
      quiz.title,
      quiz.courseId,
      quiz.courseName,
      quiz.description
     ]
      .join(" ")
      .toLowerCase();


    return (
     (!search ||
      haystack.includes(search))
     &&
     (!level ||
      quiz.level === level)
     &&
     (!status ||
      quiz.status === status)
    );

   }
  );


 table.innerHTML = "";


 if(!filtered.length){

  emptyState.style.display =
   "block";

  return;

 }


 emptyState.style.display =
  "none";


 filtered.forEach(
  quiz => {

   const tr =
    document.createElement(
     "tr"
    );


   const levelClass =
    String(
     quiz.level || ""
    ).toLowerCase();


   const statusClass =
    quiz.status === "published"
     ? "published"
     : "draft";


   tr.innerHTML = `

    <td>
     <strong>
      ${escapeHtml(
       quiz.title || quiz.name || quiz.id
      )}
     </strong>

     <div style="color:#64748b;margin-top:4px">
      ${escapeHtml(quiz.id)}
     </div>
    </td>

    <td>
     ${escapeHtml(
      quiz.courseName ||
      quiz.courseId ||
      "—"
     )}
    </td>

    <td>
     <span class="badge ${levelClass}">
      ${escapeHtml(
       quiz.level || "Beginner"
      )}
     </span>
    </td>

    <td>
     ${
      Array.isArray(quiz.questions)
       ? quiz.questions.length
       : Number(
          quiz.questionCount || 0
         )
     }
    </td>

    <td>
     ${
      Number(quiz.timeLimit || 0) > 0
       ? `${Number(quiz.timeLimit)} min`
       : "No limit"
     }
    </td>

    <td>
     ${Number(
      quiz.passingScore ?? 50
     )}%
    </td>

    <td>
     <span class="badge ${statusClass}">
      ${escapeHtml(
       quiz.status || "draft"
      )}
     </span>
    </td>

    <td>

     <div class="actions">

      <button
       class="action"
       data-action="edit"
       data-id="${escapeHtml(quiz.id)}"
      >
       Edit
      </button>

      <button
       class="action delete"
       data-action="delete"
       data-id="${escapeHtml(quiz.id)}"
      >
       Delete
      </button>

     </div>

    </td>

   `;


   table.appendChild(
    tr
   );

  }
 );

}


/* =========================
   CREATE
========================= */

document.getElementById(
 "createBtn"
).addEventListener(
 "click",
 ()=>{
  openCreateModal();
 }
);


function openCreateModal(){

 editingId = null;

 modalTitle.textContent =
  "Create Quiz";


 form.reset();


 document.getElementById(
  "quizLevel"
 ).value =
  "Beginner";


 document.getElementById(
  "quizStatus"
 ).value =
  "draft";


 document.getElementById(
  "timeLimit"
 ).value =
  "10";


 document.getElementById(
  "passingScore"
 ).value =
  "50";


 questionsContainer.innerHTML =
  "";


 questionCounter = 0;


 addQuestion();


 modal.classList.add(
  "show"
 );

}


/* =========================
   EDIT
========================= */

table.addEventListener(
 "click",
 event => {

  const button =
   event.target.closest(
    "button[data-action]"
   );


  if(!button){
   return;
  }


  const id =
   button.dataset.id;


  const action =
   button.dataset.action;


  if(action === "edit"){

   openEditModal(id);

  }


  if(action === "delete"){

   deleteQuiz(id);

  }

 });


function openEditModal(id){

 const quiz =
  quizzes.find(
   q => q.id === id
  );


 if(!quiz){
  return;
 }


 editingId =
  id;


 modalTitle.textContent =
  "Edit Quiz";


 document.getElementById(
  "quizId"
 ).value =
  quiz.id;


 document.getElementById(
  "quizId"
 ).disabled =
  true;


 document.getElementById(
  "quizTitle"
 ).value =
  quiz.title || quiz.name || "";


 document.getElementById(
  "courseId"
 ).value =
  quiz.courseId || "";


 document.getElementById(
  "courseName"
 ).value =
  quiz.courseName || "";


 document.getElementById(
  "quizLevel"
 ).value =
  quiz.level || "Beginner";


 document.getElementById(
  "timeLimit"
 ).value =
  Number(
   quiz.timeLimit || 0
  );


 document.getElementById(
  "passingScore"
 ).value =
  Number(
   quiz.passingScore ?? 50
  );


 document.getElementById(
  "quizStatus"
 ).value =
  quiz.status || "draft";


 document.getElementById(
  "quizDescription"
 ).value =
  quiz.description || "";


 questionsContainer.innerHTML =
  "";


 questionCounter = 0;


 const savedQuestions =
  Array.isArray(
   quiz.questions
  )
   ? quiz.questions
   : [];


 if(savedQuestions.length){

  savedQuestions.forEach(
   question =>
    addQuestion(
     question
    )
  );

 }else{

  addQuestion();

 }


 modal.classList.add(
  "show"
 );

}


/* =========================
   ADD QUESTION
========================= */

document.getElementById(
 "addQuestionBtn"
).addEventListener(
 "click",
 ()=>{
  addQuestion();
 }
);


function addQuestion(data = {}){

 questionCounter++;


 const number =
  questionCounter;


 const box =
  document.createElement(
   "div"
  );


 box.className =
  "question-box";


 box.dataset.number =
  number;


 const options =
  Array.isArray(data.options)
   ? data.options
   : ["","","",""];


 const correct =
  Number.isInteger(
   data.correctAnswer
  )
   ? data.correctAnswer
   : 0;


 box.innerHTML = `

  <div class="question-head">

   <strong>
    QUESTION ${number}
   </strong>

   <button
    type="button"
    class="remove-question"
   >
    Remove
   </button>

  </div>

  <div class="field" style="margin-bottom:9px">

   <label>
    Question
   </label>

   <input
    class="question-text-input"
    required
    placeholder="Write the question..."
    value="${escapeAttr(
     data.question || ""
    )}"
   >

  </div>


  <div class="options-grid">

   <div class="field">

    <label>Option A</label>

    <div class="option-row">

     <input
      class="option-input"
      required
      value="${escapeAttr(
       options[0] || ""
      )}"
      placeholder="Option A"
     >

     <select class="correct-select">
      <option value="0" ${
       correct === 0 ? "selected" : ""
      }>
       Correct
      </option>
      <option value="1" ${
       correct === 1 ? "selected" : ""
      }>
       Correct
      </option>
      <option value="2" ${
       correct === 2 ? "selected" : ""
      }>
       Correct
      </option>
      <option value="3" ${
       correct === 3 ? "selected" : ""
      }>
       Correct
      </option>
     </select>

    </div>

   </div>


   <div class="field">

    <label>Option B</label>

    <input
     class="option-input"
     required
     value="${escapeAttr(
      options[1] || ""
     )}"
     placeholder="Option B"
    >

   </div>


   <div class="field">

    <label>Option C</label>

    <input
     class="option-input"
     required
     value="${escapeAttr(
      options[2] || ""
     )}"
     placeholder="Option C"
    >

   </div>


   <div class="field">

    <label>Option D</label>

    <input
     class="option-input"
     required
     value="${escapeAttr(
      options[3] || ""
     )}"
     placeholder="Option D"
    >

   </div>

  </div>


  <div
   class="field"
   style="margin-top:9px"
  >

   <label>
    Points
   </label>

   <input
    class="points-input"
    type="number"
    min="1"
    value="${Number(
     data.points || 1
    )}"
   >

  </div>

 `;


 /*
  * Correct answer selector is placed beside
  * Option A for compactness, but controls the
  * whole question.
  */

 const correctSelect =
  box.querySelector(
   ".correct-select"
  );


 correctSelect.innerHTML = `

  <option value="0">
   A Correct
  </option>

  <option value="1">
   B Correct
  </option>

  <option value="2">
   C Correct
  </option>

  <option value="3">
   D Correct
  </option>

 `;


 correctSelect.value =
  String(correct);


 box.querySelector(
  ".remove-question"
 ).addEventListener(
  "click",
  ()=>{
   box.remove();
   renumberQuestions();
  }
 );


 questionsContainer.appendChild(
  box
 );

}


/* =========================
   RENUMBER
========================= */

function renumberQuestions(){

 const boxes =
  questionsContainer.querySelectorAll(
   ".question-box"
  );


 boxes.forEach(
  (box,index)=>{

   const heading =
    box.querySelector(
     ".question-head strong"
    );


   heading.textContent =
    `QUESTION ${index + 1}`;

  }
 );

}


/* =========================
   SAVE
========================= */

form.addEventListener(
 "submit",
 async event => {

  event.preventDefault();


  const id =
   document.getElementById(
    "quizId"
   ).value
   .trim()
   .toLowerCase();


  if(
   !/^[a-z0-9-]+$/.test(id)
  ){

   showToast(
    "Quiz ID may only contain lowercase letters, numbers and hyphens."
   );

   return;

  }


  const title =
   document.getElementById(
    "quizTitle"
   ).value.trim();


  const courseId =
   document.getElementById(
    "courseId"
   ).value.trim();


  const level =
   document.getElementById(
    "quizLevel"
   ).value;


  const timeLimit =
   Number(
    document.getElementById(
     "timeLimit"
    ).value || 0
   );


  const passingScore =
   Number(
    document.getElementById(
     "passingScore"
    ).value || 50
   );


  const status =
   document.getElementById(
    "quizStatus"
   ).value;


  const courseName =
   document.getElementById(
    "courseName"
   ).value.trim();


  const description =
   document.getElementById(
    "quizDescription"
   ).value.trim();


  const boxes =
   questionsContainer.querySelectorAll(
    ".question-box"
   );


  if(!boxes.length){

   showToast(
    "Add at least one question."
   );

   return;

  }


  const questions = [];


  for(
   const box of boxes
  ){

   const question =
    box.querySelector(
     ".question-text-input"
    ).value.trim();


   const optionInputs =
    box.querySelectorAll(
     ".option-input"
    );


   const options =
    Array.from(
     optionInputs
    ).map(
     input =>
      input.value.trim()
    );


   const correctAnswer =
    Number(
     box.querySelector(
      ".correct-select"
     ).value
    );


   const points =
    Number(
     box.querySelector(
      ".points-input"
     ).value || 1
    );


   if(
    !question ||
    options.some(
     option => !option
    )
   ){

    showToast(
     "Every question must have text and four options."
    );

    return;

   }


   questions.push({

    question,

    options,

    correctAnswer,

    points:
     Math.max(
      1,
      points
     )

   });

  }


  if(
   passingScore < 0 ||
   passingScore > 100
  ){

   showToast(
    "Passing score must be between 0 and 100."
   );

   return;

  }


  const saveBtn =
   document.getElementById(
    "saveBtn"
   );


  saveBtn.disabled =
   true;

  saveBtn.textContent =
   "Saving...";


  try{

   const currentUser =
    auth.currentUser;


   if(!currentUser){

    throw new Error(
     "You are not signed in."
    );

   }


   const quizData = {

    id,

    title,

    name:title,

    courseId,

    courseName,

    level,

    timeLimit,

    passingScore,

    status,

    description,

    questions,

    questionCount:
     questions.length,

    updatedAt:
     serverTimestamp(),

    updatedBy:
     currentUser.uid

   };


   if(!editingId){

    quizData.createdAt =
     serverTimestamp();

    quizData.createdBy =
     currentUser.uid;


    await setDoc(
     doc(
      db,
      "quizzes",
      id
     ),
     quizData
    );


    showToast(
     "Quiz created successfully."
    );

   }else{

    await updateDoc(
     doc(
      db,
      "quizzes",
      editingId
     ),
     quizData
    );


    showToast(
     "Quiz updated successfully."
    );

   }


   closeModal();

   await loadQuizzes();

  }catch(error){

   console.error(error);

   showToast(
    "Could not save quiz: " +
    error.message
   );

  }finally{

   saveBtn.disabled =
    false;

   saveBtn.textContent =
    "Save Quiz";

  }

 });


/* =========================
   DELETE
========================= */

async function deleteQuiz(id){

 const quiz =
  quizzes.find(
   q => q.id === id
  );


 if(!quiz){
  return;
 }


 const confirmed =
  confirm(
   `Delete quiz "${quiz.title || id}"?\n\nThis cannot be undone.`
  );


 if(!confirmed){
  return;
 }


 try{

  await deleteDoc(
   doc(
    db,
    "quizzes",
    id
   )
  );


  showToast(
   "Quiz deleted."
  );


  await loadQuizzes();

 }catch(error){

  console.error(error);

  showToast(
   "Could not delete quiz: " +
   error.message
  );

 }

}



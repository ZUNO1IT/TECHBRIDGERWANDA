</main>

</div>


<!-- MODAL -->

<div
 class="overlay"
 id="modalOverlay"
>

 <div class="modal">

  <div class="modal-head">

   <h2 id="modalTitle">
    Create Quiz
   </h2>

   <button
    class="close"
    id="closeModal"
   >
    ×
   </button>

  </div>



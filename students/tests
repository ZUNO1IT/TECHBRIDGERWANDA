
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>TECHBRIDGE RWANDA — Tests</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
 --bg:#070b14;
 --panel:#0d1527;
 --panel2:#111c31;
 --border:rgba(255,255,255,.08);
 --text:#f8fafc;
 --muted:#94a3b8;
 --cyan:#00e5ff;
 --blue:#3b82f6;
 --purple:#a855f7;
 --green:#22c55e;
 --red:#ef4444;
 --yellow:#f59e0b
}

body{
 font-family:Inter,Arial,sans-serif;
 color:var(--text);
 min-height:100vh;
 background:
 radial-gradient(circle at top left,rgba(0,229,255,.08),transparent 30%),
 radial-gradient(circle at bottom right,rgba(168,85,247,.08),transparent 30%),
 var(--bg)
}

button,input,select{font:inherit}
button{cursor:pointer}

.sidebar{
 position:fixed;
 inset:0 auto 0 0;
 width:260px;
 padding:22px 15px;
 background:rgba(13,21,39,.96);
 border-right:1px solid var(--border);
 backdrop-filter:blur(18px);
 z-index:100
}

.brand{
 display:flex;
 align-items:center;
 gap:12px;
 padding:8px 10px 25px
}

.logo{
 width:45px;
 height:45px;
 display:grid;
 place-items:center;
 border-radius:14px;
 color:#041018;
 font-weight:900;
 background:linear-gradient(135deg,var(--cyan),var(--blue))
}

.brand strong{display:block;font-size:14px}
.brand span{color:var(--muted);font-size:10px}

.nav-title{
 padding:12px;
 color:#64748b;
 font-size:10px;
 letter-spacing:1.4px;
 text-transform:uppercase
}

.nav{display:grid;gap:5px}

.nav a{
 display:flex;
 align-items:center;
 gap:11px;
 padding:12px;
 border-radius:12px;
 color:#cbd5e1;
 text-decoration:none;
 font-size:14px
}

.nav a:hover,.nav a.active{
 color:var(--cyan);
 background:rgba(0,229,255,.08)
}

.sidebar-bottom{
 position:absolute;
 left:15px;
 right:15px;
 bottom:18px
}

.logout{
 width:100%;
 padding:12px;
 border:1px solid rgba(239,68,68,.18);
 border-radius:12px;
 color:#fca5a5;
 background:rgba(239,68,68,.07);
 font-weight:700
}

.main{
 width:calc(100% - 260px);
 margin-left:260px;
 padding:25px
}

.mobile-header{
 display:none
}

.topbar{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:20px;
 margin-bottom:25px
}

.topbar h1{
 font-size:27px;
 margin-bottom:5px
}

.topbar p{
 color:var(--muted);
 font-size:13px
}

.profile{
 display:flex;
 align-items:center;
 gap:10px;
 padding:8px 12px;
 border:1px solid var(--border);
 border-radius:14px;
 background:rgba(255,255,255,.04)
}

.avatar{
 width:38px;
 height:38px;
 display:grid;
 place-items:center;
 border-radius:50%;
 color:#041018;
 font-weight:900;
 background:linear-gradient(135deg,var(--cyan),var(--purple))
}

.profile small{
 display:block;
 color:var(--muted);
 font-size:10px
}

.toolbar{
 display:flex;
 gap:10px;
 margin-bottom:20px
}

.search{
 flex:1;
 padding:12px 14px;
 border:1px solid var(--border);
 border-radius:12px;
 outline:none;
 color:white;
 background:rgba(255,255,255,.04)
}

.search:focus{
 border-color:rgba(0,229,255,.4)
}

.filter{
 padding:12px;
 border:1px solid var(--border);
 border-radius:12px;
 color:white;
 background:var(--panel2);
 outline:none
}

.filter option{background:var(--panel2)}

.grid{
 display:grid;
 grid-template-columns:repeat(auto-fill,minmax(290px,1fr));
 gap:15px
}

.card{
 padding:20px;
 border:1px solid var(--border);
 border-radius:18px;
 background:rgba(255,255,255,.035);
 transition:.2s
}

.card:hover{
 transform:translateY(-2px);
 border-color:rgba(0,229,255,.22)
}

.card-top{
 display:flex;
 justify-content:space-between;
 align-items:center;
 margin-bottom:15px
}

.icon{
 width:44px;
 height:44px;
 display:grid;
 place-items:center;
 border-radius:13px;
 background:rgba(168,85,247,.1);
 font-size:20px
}

.badge{
 padding:5px 9px;
 border-radius:999px;
 font-size:9px;
 font-weight:900
}

.beginner{
 color:#86efac;
 background:rgba(34,197,94,.1)
}

.intermediate{
 color:#93c5fd;
 background:rgba(59,130,246,.1)
}

.advanced{
 color:#d8b4fe;
 background:rgba(168,85,247,.1)
}

.passed{
 color:#86efac;
 background:rgba(34,197,94,.1)
}

.failed{
 color:#fca5a5;
 background:rgba(239,68,68,.1)
}

.available{
 color:#67e8f9;
 background:rgba(0,229,255,.08)
}

.card h2{
 font-size:17px;
 line-height:1.4;
 margin-bottom:8px
}

.description{
 color:var(--muted);
 font-size:12px;
 line-height:1.6;
 min-height:40px;
 margin-bottom:15px
}

.meta{
 display:flex;
 flex-wrap:wrap;
 gap:7px;
 margin-bottom:16px
}

.meta span{
 padding:6px 8px;
 border-radius:999px;
 color:#cbd5e1;
 background:rgba(255,255,255,.05);
 font-size:9px
}

.result{
 display:flex;
 justify-content:space-between;
 align-items:center;
 padding:11px;
 margin-bottom:13px;
 border:1px solid var(--border);
 border-radius:11px;
 background:rgba(255,255,255,.025)
}

.result span{
 color:var(--muted);
 font-size:10px
}

.result strong{
 color:var(--cyan);
 font-size:17px
}

.action{
 width:100%;
 padding:12px;
 border:0;
 border-radius:11px;
 color:#041018;
 background:linear-gradient(135deg,var(--cyan),var(--blue));
 font-size:12px;
 font-weight:900
}

.action.secondary{
 color:#dbeafe;
 border:1px solid rgba(59,130,246,.2);
 background:rgba(59,130,246,.09)
}

.loading,.empty,.error{
 padding:60px 20px;
 text-align:center;
 color:var(--muted)
}

.spinner{
 width:35px;
 height:35px;
 margin:0 auto 14px;
 border:3px solid rgba(255,255,255,.08);
 border-top-color:var(--cyan);
 border-radius:50%;
 animation:spin .8s linear infinite
}

@keyframes spin{
 to{transform:rotate(360deg)}
}

.error{
 color:#fca5a5;
 border:1px solid rgba(239,68,68,.2);
 border-radius:16px;
 background:rgba(239,68,68,.07)
}

@media(max-width:800px){

 .sidebar{
  transform:translateX(-100%);
  transition:.25s
 }

 .sidebar.open{
  transform:translateX(0)
 }

 .main{
  width:100%;
  margin-left:0;
  padding:18px
 }

 .mobile-header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px
 }

 .menu-btn{
  padding:9px 12px;
  border:1px solid var(--border);
  border-radius:10px;
  color:white;
  background:rgba(255,255,255,.05)
 }

 .topbar{
  flex-direction:column;
  align-items:flex-start
 }

 .toolbar{
  flex-direction:column
 }

 .filter{
  width:100%
 }
}
</style>
</head>

<body>

<aside class="sidebar" id="sidebar">

 <div class="brand">
  <div class="logo">TB</div>
  <div>
   <strong>TECHBRIDGE</strong>
   <span>RWANDA • STUDENT</span>
  </div>
 </div>

 <div class="nav-title">Learning</div>

 <nav class="nav">
  <a href="./index.html">🏠 Dashboard</a>
  <a href="./courses.html">📚 Courses</a>
  <a href="./quizzes.html">📝 Quizzes</a>
  <a href="./tests.html" class="active">🧪 Tests</a>
  <a href="./practical.html">💻 Practical</a>
 </nav>

 <div class="nav-title">Academic</div>

 <nav class="nav">
  <a href="./certificates.html">🏆 Certificates</a>
  <a href="./settings.html">⚙️ Settings</a>
 </nav>

 <div class="sidebar-bottom">
  <button class="logout" id="logoutBtn">
   Logout
  </button>
 </div>

</aside>


<main class="main">

 <div class="mobile-header">
  <strong>TECHBRIDGE RWANDA</strong>
  <button class="menu-btn" id="menuBtn">☰</button>
 </div>


 <header class="topbar">

  <div>
   <h1>Tests</h1>
   <p>
    Measure your skills across Beginner, Intermediate and Advanced levels.
   </p>
  </div>

  <div class="profile">

   <div class="avatar" id="avatar">S</div>

   <div>
    <strong id="studentName">Student</strong>
    <small>Learning Account</small>
   </div>

  </div>

 </header>


 <div class="toolbar">

  <input
   class="search"
   id="searchInput"
   placeholder="Search tests..."
   type="search"
  >

  <select class="filter" id="levelFilter">
   <option value="all">All Levels</option>
   <option value="Beginner">Beginner</option>
   <option value="Intermediate">Intermediate</option>
   <option value="Advanced">Advanced</option>
  </select>

  <select class="filter" id="resultFilter">
   <option value="all">All Tests</option>
   <option value="available">Not Attempted</option>
   <option value="passed">Passed</option>
   <option value="failed">Not Passed</option>
  </select>

 </div>


 <div id="loading" class="loading">
  <div class="spinner"></div>
  Loading tests...
 </div>


 <div id="grid" class="grid" style="display:none"></div>


 <div id="empty" class="empty" style="display:none">
  <div style="font-size:36px;margin-bottom:10px">🧪</div>
  <h3>No tests available</h3>
  <p style="margin-top:7px">
   Published tests will appear here.
  </p>
 </div>


 <div id="error" class="error" style="display:none">
  <strong>Unable to load tests</strong>
  <p id="errorText" style="margin-top:8px"></p>
 </div>

</main>


<script type="module">

import {
 initializeApp
} from "https://www.gstatic.com/firebasejs/12.3.0/firebase-app.js";

import {
 getAuth,
 onAuthStateChanged,
 signOut
} from "https://www.gstatic.com/firebasejs/12.3.0/firebase-auth.js";

import {
 getFirestore,
 collection,
 getDocs,
 query,
 where
} from "https://www.gstatic.com/firebasejs/12.3.0/firebase-firestore.js";


const firebaseConfig = {

 apiKey:
  "AIzaSyAIeekQOHDHt--r4KbPU8YOgueG3P1249g",

 authDomain:
  "techbrige-rwanda.firebaseapp.com",

 projectId:
  "techbrige-rwanda",

 storageBucket:
  "techbrige-rwanda.firebasestorage.app",

 messagingSenderId:
  "391783540774",

 appId:
  "1:391783540774:web:de825e268d4ed6b2711ee7"

};


const app =
 initializeApp(firebaseConfig);

const auth =
 getAuth(app);

const db =
 getFirestore(app);


const sidebar =
 document.getElementById("sidebar");

const menuBtn =
 document.getElementById("menuBtn");

const logoutBtn =
 document.getElementById("logoutBtn");

const studentName =
 document.getElementById("studentName");

const avatar =
 document.getElementById("avatar");

const loading =
 document.getElementById("loading");

const grid =
 document.getElementById("grid");

const empty =
 document.getElementById("empty");

const errorBox =
 document.getElementById("error");

const errorText =
 document.getElementById("errorText");

const searchInput =
 document.getElementById("searchInput");

const levelFilter =
 document.getElementById("levelFilter");

const resultFilter =
 document.getElementById("resultFilter");


let currentUser = null;
let tests = [];
let attempts = new Map();


/* =========================
   MOBILE MENU
========================= */

menuBtn.addEventListener("click",()=>{
 sidebar.classList.toggle("open");
});


/* =========================
   AUTH
========================= */

onAuthStateChanged(auth,async user=>{

 if(!user){

  window.location.href =
   "../login.html";

  return;
 }

 currentUser = user;

 const name =
  user.displayName ||
  user.email?.split("@")[0] ||
  "Student";

 studentName.textContent =
  name;

 avatar.textContent =
  name.charAt(0).toUpperCase();


 await loadData();

});


/* =========================
   LOAD DATA
========================= */

async function loadData(){

 loading.style.display="block";
 grid.style.display="none";
 empty.style.display="none";
 errorBox.style.display="none";

 try{

  /*
   * Load all tests.
   * No composite Firestore index is required.
   */

  const testSnapshot =
   await getDocs(
    collection(db,"tests")
   );


  tests =
   testSnapshot.docs
   .map(docSnap=>({
    id:docSnap.id,
    ...docSnap.data()
   }))
   .filter(test=>
    test.status === "published"
   );


  /*
   * Load only this student's attempts.
   */

  const attemptQuery =
   query(
    collection(db,"testAttempts"),
    where(
     "userId",
     "==",
     currentUser.uid
    )
   );


  const attemptSnapshot =
   await getDocs(attemptQuery);


  attempts =
   new Map();


  attemptSnapshot.docs.forEach(docSnap=>{

   const data =
    docSnap.data();

   if(!data.testId) return;

   const old =
    attempts.get(data.testId);

   const oldTime =
    old?.completedAt?.toMillis?.() || 0;

   const newTime =
    data.completedAt?.toMillis?.() || 0;


   if(!old || newTime >= oldTime){

    attempts.set(
     data.testId,
     {
      id:docSnap.id,
      ...data
     }
    );

   }

  });


  render();

 }catch(error){

  console.error(error);

  loading.style.display="none";
  errorBox.style.display="block";

  errorText.textContent =
   error.message ||
   "Please check your internet connection.";

 }

}


/* =========================
   RENDER
========================= */

function render(){

 const search =
  searchInput.value
  .trim()
  .toLowerCase();

 const level =
  levelFilter.value;

 const result =
  resultFilter.value;


 const filtered =
  tests.filter(test=>{

   const title =
    String(
     test.title || ""
    ).toLowerCase();

   const course =
    String(
     test.courseId || ""
    ).toLowerCase();

   const matchesSearch =
    !search ||
    title.includes(search) ||
    course.includes(search);


   const matchesLevel =
    level === "all" ||
    test.level === level;


   const attempt =
    attempts.get(test.id);


   const passed =
    attempt?.passed === true;

   const failed =
    attempt &&
    attempt.passed === false;


   let matchesResult = true;


   if(result==="available"){
    matchesResult=!attempt;
   }

   if(result==="passed"){
    matchesResult=passed;
   }

   if(result==="failed"){
    matchesResult=failed;
   }


   return (
    matchesSearch &&
    matchesLevel &&
    matchesResult
   );

  });


 grid.innerHTML="";


 loading.style.display="none";


 if(!filtered.length){

  grid.style.display="none";
  empty.style.display="block";

  return;
 }


 empty.style.display="none";
 grid.style.display="grid";


 filtered.forEach(test=>{

  grid.appendChild(
   createCard(test)
  );

 });

}


/* =========================
   CARD
========================= */

function createCard(test){

 const card =
  document.createElement("article");

 card.className="card";


 const attempt =
  attempts.get(test.id);


 const questionCount =
  Array.isArray(test.questions)
   ? test.questions.length
   : Number(
      test.questionCount || 0
     );


 let resultBadge =
  `<span class="badge available">
    AVAILABLE
   </span>`;


 if(attempt){

  resultBadge =
   attempt.passed === true

   ? `<span class="badge passed">
       PASSED
      </span>`

   : `<span class="badge failed">
       NOT PASSED
      </span>`;

 }


 const levelClass =
  String(
   test.level || "Beginner"
  ).toLowerCase();


 const score =
  attempt
   ? `${Number(attempt.score || 0)}%`
   : "—";


 card.innerHTML=`

  <div class="card-top">

   <div class="icon">
    🧪
   </div>

   ${resultBadge}

  </div>


  <h2>
   ${escapeHtml(
    test.title ||
    "Untitled Test"
   )}
  </h2>


  <p class="description">
   ${escapeHtml(
    test.description ||
    "Complete this assessment to measure your skills."
   )}
  </p>


  <div class="meta">

   <span>
    ${escapeHtml(
     test.level || "Beginner"
    )}
   </span>

   <span>
    ${questionCount} Questions
   </span>

   <span>
    ${
     Number(test.timeLimit || 0)>0
      ? `${test.timeLimit} min`
      : "No timer"
    }
   </span>

   ${
    test.courseId
     ? `<span>
         ${escapeHtml(test.courseId)}
        </span>`
     : ""
   }

  </div>


  <div class="result">

   <span>
    ${
     attempt
      ? "Latest Score"
      : "Passing Score"
    }
   </span>

   <strong>
    ${
     attempt
      ? score
      : `${Number(
          test.passingScore ?? 50
        )}%`
    }
   </strong>

  </div>


  <button
   class="action ${
    attempt ? "secondary" : ""
   }"
   data-id="${escapeHtml(test.id)}"
  >

   ${
    attempt
     ? "Retake Test →"
     : "Start Test →"
   }

  </button>

 `;


 const button =
  card.querySelector(".action");


 button.addEventListener(
  "click",
  ()=>{

   window.location.href =
    `./test.html?id=${
     encodeURIComponent(test.id)
    }`;

  }
 );


 return card;

}


/* =========================
   FILTER EVENTS
========================= */

searchInput.addEventListener(
 "input",
 render
);

levelFilter.addEventListener(
 "change",
 render
);

resultFilter.addEventListener(
 "change",
 render
);


/* =========================
   LOGOUT
========================= */

logoutBtn.addEventListener(
 "click",
 async()=>{

  await signOut(auth);

  window.location.href =
   "../login.html";

 }
);


/* =========================
   SAFE HTML
========================= */

function escapeHtml(value){

 return String(value)
  .replaceAll("&","&amp;")
  .replaceAll("<","&lt;")
  .replaceAll(">","&gt;")
  .replaceAll('"',"&quot;")
  .replaceAll("'","&#039;");

}

</script>

</body>
</html>

